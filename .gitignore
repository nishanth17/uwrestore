# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/

# Build/package artifacts
build/
dist/

# Data — raw footage and generated outputs
# Never commit original dive footage or generated renders
data/raw/
data/output/

# Video files by default
*.mp4
*.mov
*.mkv

# All dive footage stays local
data/testset/**/*.mp4
data/testset/**/*.MP4
data/testset/**/*.mov
data/testset/**/*.MOV

# Model checkpoints / large binaries
*.pt
*.pth
*.ckpt
*.safetensors
models/checkpoints/
checkpoints/

# Vendored third-party model repos (SEA-RAFT, WAFT, ...) — cloned locally per
# uw/searaft.py / uw/waft.py, never committed. See uw/searaft.py, uw/waft.py
# docstrings for provenance/commit pinning instead.
vendor/

# COLMAP / reconstruction artifacts
colmap_output/
*.db

# OS/editor
.DS_Store
.vscode/
.idea/

# Environment/secrets
.env
# Experiment scratch dirs (any week/phase, any nesting depth) — local-only
# artifacts: diagnostic renders, vendored model/geometry repos, heavy
# per-experiment virtualenvs, checkpoints, COLMAP DBs/sparse models,
# .ply/.npz/.pt dumps, build output. `vendor/`, `checkpoints/`, `outputs/`,
# and `build/` above already match these at any depth, so only the
# `.venv-*` naming convention needs restating here. New weeks/phases need no
# new entries. Small curated JSON summaries a report cites are force-added
# individually with `git add -f`, never by relaxing this rule.
outputs/
experiments/**/.venv-*/

# Pre-repair snapshots of Week-4 result files (local provenance, not tracked)
experiments/week4_mono/archive/
