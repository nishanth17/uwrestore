# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/

# Build/package artifacts
build/
dist/

# Data — raw footage and generated outputs
# Never commit original dive footage or generated renders
data/raw/
data/output/

# Video files by default
*.mp4
*.mov
*.mkv

# All dive footage stays local
data/testset/**/*.mp4
data/testset/**/*.MP4
data/testset/**/*.mov
data/testset/**/*.MOV

# Model checkpoints / large binaries
*.pt
*.pth
*.ckpt
*.safetensors
models/checkpoints/
checkpoints/

# Vendored third-party model repos (SEA-RAFT, WAFT, ...) — cloned locally per
# uw/searaft.py / uw/waft.py, never committed. See uw/searaft.py, uw/waft.py
# docstrings for provenance/commit pinning instead.
vendor/

# COLMAP / reconstruction artifacts
colmap_output/
*.db

# OS/editor
.DS_Store
.vscode/
.idea/

# Environment/secrets
.env
# Week 2 Phase 1A optical-flow exploration (local artifacts only)
# Diagnostic renders are derived from local dive footage and must stay local,
# same rule as the footage itself.
outputs/
experiments/week2a_flow/.venv-*/
experiments/week2a_flow/vendor/
experiments/week2a_flow/checkpoints/

# Week 3 geometry bakeoff (local artifacts only) — same rule as Week 2:
# heavy environments, vendored geometry repos, checkpoints and reconstructions
# are rebuilt/cloned from the pinned commits in FINDINGS.md, never committed.
experiments/week3_geometry/.venv-*/
experiments/week3_geometry/vendor/
experiments/week3_geometry/checkpoints/
experiments/week3_geometry/build/
