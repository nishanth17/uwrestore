{
  "stage": "S4",
  "perturbations": [
    {
      "name": "wb_warm",
      "kind": "channel_gain",
      "params": {
        "gain": [
          1.25,
          1.0,
          0.8
        ]
      },
      "probes": "white balance pushed warm; a pure per-channel gain in linear light"
    },
    {
      "name": "wb_cool",
      "kind": "channel_gain",
      "params": {
        "gain": [
          0.8,
          1.0,
          1.25
        ]
      },
      "probes": "white balance pushed cool, the opposite gain"
    },
    {
      "name": "channel_neutralize",
      "kind": "gray_world",
      "params": {},
      "probes": "channel neutralisation: each linear channel scaled to a common mean, i.e. the colour cast removed the way the project's gray-world baseline does"
    },
    {
      "name": "attenuation_red",
      "kind": "channel_gain",
      "params": {
        "gain": [
          0.45,
          0.9,
          1.0
        ]
      },
      "probes": "stronger Beer-Lambert-like red loss, uniform over the frame so it changes appearance WITHOUT encoding depth"
    },
    {
      "name": "contrast_low",
      "kind": "contrast",
      "params": {
        "factor": 0.7
      },
      "probes": "contrast reduced about the frame's linear mean"
    },
    {
      "name": "contrast_high",
      "kind": "contrast",
      "params": {
        "factor": 1.4
      },
      "probes": "contrast increased about the frame's linear mean"
    },
    {
      "name": "brightness_down",
      "kind": "gain",
      "params": {
        "factor": 0.6
      },
      "probes": "exposure down; a pure scalar on linear radiance"
    },
    {
      "name": "brightness_up",
      "kind": "gain",
      "params": {
        "factor": 1.6
      },
      "probes": "exposure up"
    },
    {
      "name": "veil_uniform",
      "kind": "veil",
      "params": {
        "t": 0.6
      },
      "probes": "uniform veiling light: x -> t*x + (1-t)*A. Haze-LIKE appearance with NO depth dependence, so the geometry cue is unchanged"
    },
    {
      "name": "hotspot",
      "kind": "hotspot",
      "params": {
        "strength": 0.55,
        "sigma_frac": 0.22
      },
      "probes": "artificial dive light: a bright radial falloff added in linear light, the illumination structure a torch or video light produces"
    },
    {
      "name": "cue_conflict_inverted_veil",
      "kind": "veil_depth",
      "params": {
        "t_near": 0.45,
        "t_far": 0.95
      },
      "probes": "CUE CONFLICT: veil strength runs OPPOSITE to the reference depth, so the image says 'far' where the geometry says 'near'. The reference builds the stimulus and never reaches the model"
    },
    {
      "name": "veil_depth_consistent",
      "kind": "veil_depth",
      "params": {
        "t_near": 0.95,
        "t_far": 0.45
      },
      "probes": "the CONTROL for the cue-conflict case: the same veil magnitude applied in the physically correct direction"
    }
  ],
  "window": 16,
